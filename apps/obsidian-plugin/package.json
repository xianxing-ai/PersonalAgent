{
  "name": "@personal-agent/obsidian-plugin",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node --check src/main.cjs && node --check src/installation.mjs && node --check scripts/install.mjs",
    "install:vault": "node scripts/install.mjs",
