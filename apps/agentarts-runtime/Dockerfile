# Build context is generated by scripts/image-context.mjs; never the repository root.
ARG NODE_BASE_IMAGE=node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d
FROM ${NODE_BASE_IMAGE} AS laya-wheels
COPY assets/laya-wheelhouse /wheels
FROM ${NODE_BASE_IMAGE}
ARG DEBIAN_MIRROR=http://mirrors.huaweicloud.com
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
 && apt-get update && apt-get install --no-install-recommends -y python3 python3-venv ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY scripts/laya/requirements-image.txt /opt/laya/requirements-image.txt
RUN --mount=type=bind,from=laya-wheels,source=/wheels,target=/opt/laya/wheelhouse,ro \
    python3 -m venv /opt/laya/venv \
 && test -f /opt/laya/wheelhouse/wheelhouse-manifest.json \
 && /opt/laya/venv/bin/pip install --no-cache-dir --only-binary=:all: --no-index --find-links=/opt/laya/wheelhouse -r /opt/laya/requirements-image.txt \
 && /opt/laya/venv/bin/pip check \
 && /opt/laya/venv/bin/python -c "import torch, transformers; assert torch.__version__ == '2.14.0+cpu' and torch.version.cuda is None; print('ARM64 CPU Torch and Transformers import verified')"
WORKDIR /opt/personal-agent
COPY package.json package-lock.json npm-registry.json ./
COPY packages ./packages
COPY apps ./apps
COPY scripts ./scripts
COPY assets/laya/multilingual /opt/laya/models/multilingual
RUN image_registry="$(node -p "JSON.parse(require('node:fs').readFileSync('npm-registry.json')).registry")" \
 && npm install --global npm@11.12.1 --registry="${image_registry}" \
 && npm ci --omit=dev --ignore-scripts --no-audit --no-fund --registry="${image_registry}"
ENV NODE_ENV=production PORT=8080 PA_AGENT_HOST_MODE=agentarts PA_AGENT_LAYA_MODE=embedded \
    LAYA_MODEL_PATH=/opt/laya/models/multilingual LAYA_PORT=8000 LAYA_VERIFY_MANIFEST=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=120s CMD node -e "fetch('http://127.0.0.1:8080/ping').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "apps/agentarts-runtime/src/main.mjs"]
