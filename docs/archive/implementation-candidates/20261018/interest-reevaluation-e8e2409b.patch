index 0000000000000000000000000000000000000000..5b7a29d9c2628f98636f32bcef12b37dcb9ba777
--- /dev/null
+++ b/packages/cognition/src/interest-reevaluation.ts
@@ -0,0 +1,140 @@
+import {createHash} from 'node:crypto';
+import {buildInterestOptions} from './interest-options.js';
+import type {InterestOptions} from './interest-options.js';
+import type {InterestEvidence, InterestEvidenceRef, InterestPolicyInput} from './interest-policy.js';
+
+/** Save only after the existing Runtime has durably accepted the decision task under workKey. */
+export interface InterestReevaluationCheckpoint {
+  readonly version: 1;
+  readonly namespace: string;
+  readonly topicId: string;
+  readonly fingerprint: string;
+  readonly workKey: string;
+  readonly evaluatedAt: string;
+  readonly nextEvaluationAt?: string;
+  readonly policyExpiresAt?: string;
+}
+export interface InterestReevaluationPlan {
+  readonly built: InterestOptions;
+  /** An idempotency identity for a host-owned Runtime decision task, not a model decision. */
+  readonly workKey: string;
+  /** Read back the existing Runtime task; this does not assert that it completed. */
+  readonly duplicate: boolean;
+  readonly checkpoint: InterestReevaluationCheckpoint;
+}
+
+const nonempty = (value: unknown): value is string => typeof value === 'string' && value.trim().length > 0;
+function instant(value: string): number {
+  const parsed = Date.parse(value);
+  if (!Number.isFinite(parsed)) throw Error('Invalid interest reevaluation timestamp');
+  return parsed;
+}
+const digest = (value: unknown): string => createHash('sha256').update(JSON.stringify(value)).digest('hex');
+const evidenceKey = (e: InterestEvidence): string => JSON.stringify([
+  e.id, e.topicId, e.sourceId, e.sourceRevision, instant(e.occurredAt), e.interactionId,
+  e.kind, e.match, e.relatedEvidenceId ?? null]);
+const refKey = (e: InterestEvidenceRef): string => JSON.stringify([e.id, e.topicId, e.sourceId, e.sourceRevision]);
+const sortBy = <T>(values: readonly T[], key: (value: T) => string): T[] =>
+  [...values].sort((a, b) => key(a).localeCompare(key(b)));
+function uniqueById<T extends {readonly id: string}>(values: readonly T[], key: (value: T) => string): T[] {
+  const seen = new Map<string, string>();
+  const unique: T[] = [];
+  for (const value of values) {
+    const encoded = key(value), prior = seen.get(value.id);
+    if (prior !== undefined && prior !== encoded) throw Error('Conflicting interest evidence identity');
+    if (prior === undefined) { seen.set(value.id, encoded); unique.push(value); }
+  }
+  return sortBy(unique, key);
+}
+function checkpointAt(value: InterestReevaluationCheckpoint, namespace: string, topicId: string, at: number): void {
+  if (!value || typeof value !== 'object' || Array.isArray(value)
+    || ![Object.prototype, null].includes(Object.getPrototypeOf(value))
+    || Reflect.ownKeys(value).some(key => typeof key !== 'string' || ![
+      'version', 'namespace', 'topicId', 'fingerprint', 'workKey', 'evaluatedAt',
+      'nextEvaluationAt', 'policyExpiresAt'].includes(key))
+    || value.version !== 1 || value.namespace !== namespace || value.topicId !== topicId
+    || !/^[a-f0-9]{64}$/.test(value.fingerprint) || !/^[a-f0-9]{64}$/.test(value.workKey)
+    || !nonempty(value.evaluatedAt)) throw Error('Invalid interest reevaluation checkpoint');
+  const previous = instant(value.evaluatedAt);
+  if (at < previous || (value.nextEvaluationAt !== undefined
+    && (!nonempty(value.nextEvaluationAt) || instant(value.nextEvaluationAt) <= previous))
+    || (value.policyExpiresAt !== undefined && (!nonempty(value.policyExpiresAt)
+      || instant(value.policyExpiresAt) < previous))) throw Error('Invalid interest reevaluation checkpoint time');
+}
+function nextBoundary(input: InterestPolicyInput, built: InterestOptions, at: number): string | undefined {
+  const future: number[] = [];
+  const add = (time: number) => { if (time > at) future.push(time); };
+  for (const e of input.evidence) {
+    if (e.topicId !== input.topicId || e.match === 'keyword') continue;
+    const occurred = instant(e.occurredAt);
+    add(occurred);
+    // Policy treats evidence as current at exactly maxAgeMs, then stale one millisecond later.
+    add(occurred + input.evidenceMaxAgeMs + 1);
+  }
+  if (input.explicitEnable?.topicId === input.topicId) {
+    const occurred = instant(input.explicitEnable.occurredAt);
+    add(occurred);
+    add(occurred + input.evidenceMaxAgeMs + 1);
+  }
+  add(instant(input.scope.expiresAt));
+  if (input.source) add(instant(input.source.verificationExpiresAt));
+  if (built.policy.expiresAt) add(instant(built.policy.expiresAt));
+  return future.length ? new Date(Math.min(...future)).toISOString() : undefined;
+}
+
+/** Pure trigger planning. Source heads and scope authority must be read back by the trusted host. */
+export function planInterestReevaluation(request: {
+  readonly namespace: string;
+  readonly input: InterestPolicyInput;
+  readonly checkpoint?: InterestReevaluationCheckpoint;
+}): InterestReevaluationPlan {
+  if (!request || typeof request !== 'object' || Array.isArray(request)
+    || ![Object.prototype, null].includes(Object.getPrototypeOf(request))
+    || Reflect.ownKeys(request).some(key => typeof key !== 'string'
+      || !['namespace', 'input', 'checkpoint'].includes(key))
+    || !nonempty(request.namespace)) throw Error('Invalid interest reevaluation request');
+  const input = structuredClone(request.input);
+  buildInterestOptions(input); // Reuse the policy's strict public input validation.
+  const at = instant(input.at);
+  const evidence = uniqueById(input.evidence, evidenceKey);
+  const classification = input.classification && {...input.classification,
+    evidence: uniqueById(input.classification.evidence, refKey)};
+  const normalized: InterestPolicyInput = {...input, evidence,
+    ...(classification ? {classification} : {})};
+  const built = buildInterestOptions(normalized);
+  if (request.checkpoint) checkpointAt(request.checkpoint, request.namespace, input.topicId, at);
+  const effective = evidence.filter(e => e.topicId === input.topicId && e.match !== 'keyword'
+    && instant(e.occurredAt) <= at && at - instant(e.occurredAt) <= input.evidenceMaxAgeMs);
+  const pending = evidence.filter(e => e.topicId === input.topicId && e.match !== 'keyword'
+    && instant(e.occurredAt) > at);
+  const fingerprint = digest({topicId: input.topicId, evidenceMaxAgeMs: input.evidenceMaxAgeMs,
+    watchDurationMs: input.watchDurationMs, evidence: effective, pendingEvidence: pending,
+    source: input.source ?? null,
+    scope: input.scope, previous: input.previous ?? null, tombstone: input.tombstone ?? null,
+    explicitEnable: input.explicitEnable ?? null, classification: classification ?? null,
+    policy: {state: built.policy.state, reason: built.policy.reason,
+      evidence: sortBy(built.policy.evidence, refKey), source: built.policy.source ?? null}});
+  const prior = request.checkpoint;
+  const due = prior?.nextEvaluationAt !== undefined && at >= instant(prior.nextEvaluationAt);
+  if (prior?.fingerprint === fingerprint && !due) {
+    // Preserve the original validity window; a harmless poll cannot renew it.
+    const expiresAt = prior.policyExpiresAt;
+    const unchanged = expiresAt && built.policy.expiresAt
+      ? {...built, policy: {...built.policy, expiresAt}, options: built.options.map(option =>
+        option.id === 'track_public' && option.source
+          ? {...option, source: {...option.source, validUntil: expiresAt}} : option)} : built;
+    return structuredClone({built: unchanged, workKey: prior.workKey, duplicate: true,
+      checkpoint: prior});
+  }
+  // The prior committed identity forms an epoch. A retry with the same prior checkpoint
+  // produces the same key even if the new policy expires relative to the current clock.
+  const workKey = digest({kind: 'interest-reevaluation-v1', namespace: request.namespace,
+    topicId: input.topicId, fingerprint, prior: prior?.workKey ?? null,
+    boundary: due ? prior?.nextEvaluationAt : null});
+  const nextEvaluationAt = nextBoundary(normalized, built, at);
+  const checkpoint: InterestReevaluationCheckpoint = {version: 1, namespace: request.namespace,
+    topicId: input.topicId, fingerprint, workKey, evaluatedAt: input.at,
+    ...(nextEvaluationAt ? {nextEvaluationAt} : {}),
+    ...(built.policy.expiresAt ? {policyExpiresAt: built.policy.expiresAt} : {})};
+  return structuredClone({built, workKey, duplicate: false, checkpoint});
+}
diff --git a/packages/cognition/test/interest-reevaluation.test.mjs b/packages/cognition/test/interest-reevaluation.test.mjs
