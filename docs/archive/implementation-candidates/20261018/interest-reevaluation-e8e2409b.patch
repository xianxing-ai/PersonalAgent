index 0000000000000000000000000000000000000000..a4abae4836003d711f2a0977e9b0d1759a9c6e65
--- /dev/null
+++ b/packages/cognition/test/interest-reevaluation.test.mjs
@@ -0,0 +1,120 @@
+import assert from 'node:assert/strict';
+import {test} from 'node:test';
+import {planInterestReevaluation} from '../dist/interest-reevaluation.js';
+
+const minute = 60_000;
+const base = Date.parse('2026-01-01T00:00:00.000Z');
+const iso = value => new Date(value).toISOString();
+const evidence = (id, kind, occurredAt, extra = {}) => ({id, topicId: 'topic',
+  sourceId: 'conversation', sourceRevision: 'r1', occurredAt: iso(occurredAt),
+  interactionId: id, kind, match: 'semantic', ...extra});
+function fixture(at = base) {
+  return {topicId: 'topic', at: iso(at), evidenceMaxAgeMs: 120 * minute,
+    watchDurationMs: 30 * minute,
+    evidence: [evidence('q', 'question', base - minute),
+      evidence('f', 'followup', base, {relatedEvidenceId: 'q'})],
+    source: {id: 'public-source', revision: 's1', visibility: 'public', risk: 'low',
+      transportVerified: true, verificationExpiresAt: iso(base + 180 * minute)},
+    scope: {state: 'granted', id: 'scope', revision: 1,
+      publicLowRiskTracking: true, expiresAt: iso(base + 180 * minute)}};
+}
+const plan = (input, checkpoint) => planInterestReevaluation({namespace: 'user-A', input, checkpoint});
+
+test('reordered and identical evidence, polling, and JSON restart reuse one bounded identity', () => {
+  const input = fixture();
+  const first = plan(input);
+  assert.equal(first.built.policy.state, 'watch_public');
+  assert.equal(first.duplicate, false);
+  assert.equal(first.checkpoint.nextEvaluationAt, iso(base + 30 * minute));
+  const resumed = plan({...input, at: iso(base + 5 * minute),
+    evidence: [input.evidence[1], input.evidence[0], input.evidence[0]]},
+  JSON.parse(JSON.stringify(first.checkpoint)));
+  assert.equal(resumed.duplicate, true);
+  assert.equal(resumed.workKey, first.workKey);
+  assert.deepEqual(resumed.checkpoint, first.checkpoint);
+  assert.equal(resumed.built.policy.expiresAt, first.built.policy.expiresAt);
+  assert.equal(resumed.built.options[0].source.validUntil, first.built.options[0].source.validUntil);
+  assert.throws(() => plan({...input, evidence: [input.evidence[0],
+    {...input.evidence[0], interactionId: 'different'}]}), /Conflicting/);
+});
+
+test('watch window boundary creates a stable new key until its Runtime task is checkpointed', () => {
+  const input = fixture();
+  const first = plan(input);
+  const atBoundary = plan({...input, at: iso(base + 30 * minute)}, first.checkpoint);
+  assert.equal(atBoundary.duplicate, false);
+  assert.notEqual(atBoundary.workKey, first.workKey);
+  assert.equal(atBoundary.checkpoint.nextEvaluationAt, iso(base + 60 * minute));
+  const crashReplay = plan({...input, at: iso(base + 30 * minute + 1000)}, first.checkpoint);
+  assert.equal(crashReplay.workKey, atBoundary.workKey);
+  assert.equal(crashReplay.duplicate, false);
+  assert.equal(plan({...input, at: iso(base + 31 * minute)}, atBoundary.checkpoint).duplicate, true);
+});
+
+test('new future evidence advances a previously committed watch boundary', () => {
+  const input = fixture();
+  const first = plan(input);
+  assert.equal(first.checkpoint.nextEvaluationAt, iso(base + 30 * minute));
+  const future = evidence('new-bookmark', 'bookmark', base + 10 * minute);
+  const scheduled = plan({...input, at: iso(base + minute),
+    evidence: [...input.evidence, future]}, first.checkpoint);
+  assert.equal(scheduled.duplicate, false);
+  assert.notEqual(scheduled.workKey, first.workKey);
+  assert.equal(scheduled.checkpoint.nextEvaluationAt, future.occurredAt);
+  const activated = plan({...input, at: future.occurredAt,
+    evidence: [...input.evidence, future]}, scheduled.checkpoint);
+  assert.equal(activated.duplicate, false);
+  assert.notEqual(activated.workKey, scheduled.workKey);
+});
+
+test('scope revocation, source revision, and configuration changes require distinct reviews', () => {
+  const input = fixture();
+  const first = plan(input);
+  const revoked = plan({...input, scope: {...input.scope, state: 'revoked', revision: 2}}, first.checkpoint);
+  assert.notEqual(revoked.workKey, first.workKey);
+  assert.deepEqual(revoked.built.options.map(option => option.id), ['stop_tracking', 'keep_revoked']);
+  const source = plan({...input, source: {...input.source, revision: 's2'}}, first.checkpoint);
+  assert.notEqual(source.workKey, first.workKey);
+  const configured = plan({...input, watchDurationMs: 20 * minute}, first.checkpoint);
+  assert.notEqual(configured.workKey, first.workKey);
+  assert.throws(() => plan(input, {...first.checkpoint, namespace: 'user-B'}), /checkpoint/);
+  assert.throws(() => plan({...input, at: iso(base - 1)}, first.checkpoint), /checkpoint time/);
+});
+
+test('future evidence activates at its timestamp and decays one millisecond after max age', () => {
+  const input = fixture();
+  const future = evidence('future', 'bookmark', base + 10 * minute);
+  const start = plan({...input, evidence: [future], watchDurationMs: 180 * minute});
+  assert.equal(start.checkpoint.nextEvaluationAt, future.occurredAt);
+  const activated = plan({...input, at: future.occurredAt, evidence: [future],
+    watchDurationMs: 180 * minute}, start.checkpoint);
+  assert.notEqual(activated.workKey, start.workKey);
+  const oldest = evidence('old', 'question', base - 120 * minute);
+  const exact = plan({...input, evidence: [oldest], watchDurationMs: 180 * minute});
+  assert.equal(exact.built.policy.evidence.length, 1);
+  assert.equal(exact.checkpoint.nextEvaluationAt, iso(base + 1));
+  const stale = plan({...input, at: iso(base + 1), evidence: [oldest],
+    watchDurationMs: 180 * minute}, exact.checkpoint);
+  assert.equal(stale.built.policy.evidence.length, 0);
+  assert.notEqual(stale.workKey, exact.workKey);
+});
+
+test('source, scope and explicit enable validity boundaries do not extend through duplicate polls', () => {
+  const input = fixture();
+  const near = {...input, source: {...input.source, verificationExpiresAt: iso(base + minute)},
+    scope: {...input.scope, expiresAt: iso(base + 2 * minute)}};
+  const first = plan(near);
+  assert.equal(first.checkpoint.nextEvaluationAt, iso(base + minute));
+  assert.equal(plan({...near, at: iso(base + minute - 1)}, first.checkpoint).duplicate, true);
+  const expired = plan({...near, at: iso(base + minute)}, first.checkpoint);
+  assert.equal(expired.built.policy.reason, 'public_source_not_verified');
+  assert.notEqual(expired.workKey, first.workKey);
+  const enable = {...input, evidence: [], explicitEnable: {id: 'enable', topicId: 'topic',
+    occurredAt: iso(base)}};
+  const enabled = plan(enable);
+  assert.equal(enabled.built.policy.state, 'watch_public');
+  const stillValid = plan({...enable, at: iso(base + 120 * minute)}, enabled.checkpoint);
+  assert.equal(stillValid.built.policy.reason, 'explicit_user_enable');
+  const elapsed = plan({...enable, at: iso(base + 120 * minute + 1)}, stillValid.checkpoint);
+  assert.notEqual(elapsed.built.policy.reason, 'explicit_user_enable');
+});
