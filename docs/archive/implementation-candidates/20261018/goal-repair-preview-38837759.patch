+test('integrated dialog shows repair preview for candidate task and clears it when drafting a new goal', async t => {
+  const repairTask = {
+    taskId: 'repair-task-42',
+    revision: 2,
+    state: 'waiting_approval',
+    approval: {state: 'pending', approvalId: 'app-42', revision: 1, expiresAt: '2099-01-01T00:00:00.000Z'},
+    candidate: {
+      expectedGraphRevision: 2,
+      changes: [
+        {
+          node: {id: goals[0].id, revision: 1},
+          summary: 'Revised summary for A',
+          reason: 'Meeting adjusted',
+          dependencies: [{id: 'new-dep', revision: 1}],
+        },
+      ],
+    },
+  };
+  const ui = fixture(t, (name, id) => {
+    if (name === 'goal.readTask' && id === repairTask.taskId) return repairTask;
+  }, [repairTask]);
+
+  await ui.open();
+  // Automatically loads pending repair task upon opening
+  assert.equal(ui.repairPreview.hidden, false);
+  const previewText = textOf(ui.repairPreview);
+  assert.match(previewText, /计划修复预览/);
+  assert.match(previewText, /待确认/);
+  assert.match(previewText, /受影响的计划（1）/);
+  assert.match(previewText, /Revised summary for A/);
+  assert.match(previewText, /原摘要：\s*Summary synthetic-A/);
+  assert.match(previewText, /保持不变的计划（1）/);
+  assert.match(previewText, /synthetic-B/);
+
+  // When clicking "新建目标", preview is hidden/cleared
+  ui.button('新建目标').onclick();
+  assert.equal(ui.repairPreview.hidden, true);
+  assert.equal(ui.repairPreview.children.length, 0);
+
+  // Clicking history re-opens the repair preview
+  await ui.history(0);
+  assert.equal(ui.repairPreview.hidden, false);
+  assert.match(textOf(ui.repairPreview), /Revised summary for A/);
+});
