+test('repair preview reflects pending, version conflict, and insufficient information statuses accurately', t => {
+  fakeDoc(t);
+  const validCandidate = {
+    expectedGraphRevision: 5,
+    changes: [
+      {node: {id: 'task-node', revision: 1}, summary: 'Step', reason: 'Because of change', dependencies: []},
+    ],
+  };
+
+  // 1. Pending (待确认)
+  const pendingTask = {
+    state: 'waiting_approval',
+    approval: {state: 'pending'},
+    candidate: validCandidate,
+  };
+  const pendingPreview = projectRepairPreview({task: pendingTask, graphRevision: 5});
+  assert.equal(pendingPreview.status, 'pending');
+  assert.equal(pendingPreview.statusLabel, '待确认');
+  assert.match(pendingPreview.statusMessage, /待确认|人工核对/);
+
+  // 2. Version conflict (版本冲突)
+  const mismatchPreview = projectRepairPreview({candidate: validCandidate, graphRevision: 6});
+  assert.equal(mismatchPreview.status, 'conflict');
+  assert.equal(mismatchPreview.statusLabel, '版本冲突');
+  assert.match(mismatchPreview.statusMessage, /版本冲突.*当前计划图版本（6）与修复预期版本（5）不一致/);
+
+  const conflictTask = {
+    result: {kind: 'conflict', graphRevision: 7},
+    expectedGraphRevision: 5,
+    candidate: validCandidate,
+  };
+  const taskConflictPreview = projectRepairPreview({task: conflictTask, graphRevision: 7});
+  assert.equal(taskConflictPreview.status, 'conflict');
+  assert.equal(taskConflictPreview.statusLabel, '版本冲突');
+
+  // 3. Insufficient information (信息不足)
+  const noRevCandidate = {
+    changes: [{node: {id: 'node-1', revision: 1}, summary: 'Step'}],
+  };
+  const noRevPreview = projectRepairPreview({candidate: noRevCandidate, graphRevision: 5});
+  assert.equal(noRevPreview.status, 'insufficient');
+  assert.equal(noRevPreview.statusLabel, '信息不足');
+  assert.match(noRevPreview.statusMessage, /缺少预期图版本/);
+
+  const emptyChangesCandidate = {
+    expectedGraphRevision: 5,
+    changes: [],
+  };
+  const emptyPreview = projectRepairPreview({candidate: emptyChangesCandidate, graphRevision: 5});
+  assert.equal(emptyPreview.status, 'insufficient');
+  assert.equal(emptyPreview.statusLabel, '信息不足');
+  assert.match(emptyPreview.statusMessage, /未包含任何受影响的计划变更/);
+
+  const uncertainTask = {
+    action: 'RECHECK',
+    result: {kind: 'uncertain', text: '缺少合法图谱上下文，无法生成修复候选。'},
+  };
+  const uncertainPreview = projectRepairPreview({task: uncertainTask, graphRevision: 5});
+  assert.equal(uncertainPreview.status, 'insufficient');
+  assert.equal(uncertainPreview.statusLabel, '信息不足');
+  assert.match(uncertainPreview.statusMessage, /缺少合法图谱上下文/);
+
+  const container = new FakeElement('section');
+  renderRepairPreview(container, mismatchPreview);
+  const conflictBadge = walk(container).find(n => n.dataset.statusBadge === 'conflict' || n.attrs['data-status-badge'] === 'conflict');
+  assert.ok(conflictBadge);
+  assert.equal(conflictBadge.textContent, '版本冲突');
+
+  renderRepairPreview(container, uncertainPreview);
+  const insufficientBadge = walk(container).find(n => n.dataset.statusBadge === 'insufficient' || n.attrs['data-status-badge'] === 'insufficient');
+  assert.ok(insufficientBadge);
+  assert.equal(insufficientBadge.textContent, '信息不足');
+});
