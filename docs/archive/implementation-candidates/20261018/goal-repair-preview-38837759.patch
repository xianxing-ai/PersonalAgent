diff --git a/apps/desktop/src/features/conversation/goal-view.js b/apps/desktop/src/features/conversation/goal-view.js
index cc8f0ea026f9631ee623b7df90311ae8ed6fec0c..bda4a7afac02cd66ad174975308956ea12a003eb 100644
--- a/apps/desktop/src/features/conversation/goal-view.js
+++ b/apps/desktop/src/features/conversation/goal-view.js
@@ -10,0 +11,318 @@ export function appliedGoalRef(task) {
+export function formatDependencies(deps) {
+  if (!deps) return '无依赖';
+  if (!Array.isArray(deps)) return String(deps);
+  if (deps.length === 0) return '无依赖';
+  return deps.map(dep => {
+    if (!dep || typeof dep !== 'object') return String(dep);
+    const id = dep.id ?? '未知ID';
+    const rev = Number.isSafeInteger(dep.revision) ? `@${dep.revision}` : '';
+    return `${id}${rev}`;
+  }).join('、');
+}
+
+export function extractRepairCandidate(task) {
+  if (!task || typeof task !== 'object') return null;
+  if (task.candidate && Array.isArray(task.candidate.changes)) return task.candidate;
+  if (task.kind === 'repair_candidate' && task.candidate) return task.candidate;
+  if (task.repairCandidate?.candidate) return task.repairCandidate.candidate;
+  if (task.repairCandidate?.changes) return task.repairCandidate;
+  if (task.repair?.candidate) return task.repair.candidate;
+  if (task.repair?.changes) return task.repair;
+  if (task.result?.candidate) return task.result.candidate;
+  if (task.result?.repairCandidate?.candidate) return task.result.repairCandidate.candidate;
+  if (task.result?.repair?.changes) return task.result.repair;
+  if (task.approval?.candidate) return task.approval.candidate;
+  if (task.approval?.repairCandidate?.candidate) return task.approval.repairCandidate.candidate;
+  if (Array.isArray(task.changes)) return task;
+  return null;
+}
+
+export function projectRepairPreview({task = null, candidate = null, goals = [], graphRevision = null} = {}) {
+  const resolvedCandidate = candidate ?? extractRepairCandidate(task);
+  const expectedGraphRevision = Number.isSafeInteger(resolvedCandidate?.expectedGraphRevision)
+    ? resolvedCandidate.expectedGraphRevision
+    : (Number.isSafeInteger(task?.expectedGraphRevision)
+      ? task.expectedGraphRevision
+      : (Number.isSafeInteger(task?.result?.expectedGraphRevision) ? task.result.expectedGraphRevision : null));
+  const currentGraphRevision = Number.isSafeInteger(graphRevision)
+    ? graphRevision
+    : (Number.isSafeInteger(task?.result?.graphRevision) ? task.result.graphRevision : null);
+
+  const isConflictResult = task?.result?.kind === 'conflict';
+  const isConflictError = task?.error?.code === 'CONFLICT' || task?.error?.code === 'VERSION_CONFLICT';
+  const isRevisionMismatch = expectedGraphRevision !== null && currentGraphRevision !== null
+    && expectedGraphRevision !== currentGraphRevision;
+  const isConflict = isConflictResult || isConflictError || isRevisionMismatch;
+
+  const isUncertain = task?.result?.kind === 'uncertain' || task?.action === 'RECHECK';
+  const isMissingContext = (typeof task?.result?.text === 'string' && task.result.text.includes('缺少合法图谱上下文'))
+    || (typeof task?.error?.message === 'string' && task.error.message.includes('缺少'))
+    || Boolean(resolvedCandidate && typeof resolvedCandidate.message === 'string' && resolvedCandidate.message.includes('缺少'));
+  const hasNoChanges = !resolvedCandidate || !Array.isArray(resolvedCandidate.changes) || resolvedCandidate.changes.length === 0;
+  const hasNoExpectedRevision = expectedGraphRevision === null;
+  const isReconciliationNoCandidate = task?.state === 'waiting_reconciliation' && !resolvedCandidate;
+  const isInsufficient = !isConflict && (isUncertain || isMissingContext || (resolvedCandidate && hasNoExpectedRevision) || hasNoChanges || isReconciliationNoCandidate);
+
+  let status = 'pending';
+  let statusLabel = '待确认';
+  let statusMessage = '修复方案待人工核对；请确认具体计划与依赖变化后再做决定。';
+
+  if (isConflict) {
+    status = 'conflict';
+    statusLabel = '版本冲突';
+    statusMessage = `版本冲突：当前计划图版本（${currentGraphRevision ?? '未知'}）与修复预期版本（${expectedGraphRevision ?? '未知'}）不一致，方案基于过期版本，无法直接应用。`;
+  } else if (isInsufficient) {
+    status = 'insufficient';
+    statusLabel = '信息不足';
+    if (isMissingContext || isUncertain) {
+      statusMessage = '缺少合法图谱上下文或依赖依据，无法形成确定性修复方案，需重新核查事实。';
+    } else if (resolvedCandidate && hasNoExpectedRevision) {
+      statusMessage = '信息不足：修复方案缺少预期图版本。';
+    } else if (hasNoChanges) {
+      statusMessage = '信息不足：修复方案未包含任何受影响的计划变更。';
+    } else {
+      statusMessage = task?.error?.message || '缺少必要图谱信息或执行依据。';
+    }
+  } else if (task?.state === 'succeeded' && task.result?.kind === 'applied') {
+    status = 'applied';
+    statusLabel = '已应用';
+    statusMessage = `计划修复已成功写入图谱（图版本 ${currentGraphRevision ?? '已更新'}）。`;
+  } else if (task?.state === 'failed') {
+    status = 'failed';
+    statusLabel = '任务失败';
+    statusMessage = task.error?.message || '修复任务未成功应用。';
+  } else if (task?.state === 'cancelled') {
+    status = 'cancelled';
+    statusLabel = '已取消';
+    statusMessage = '修复任务已取消。';
+  } else if (task?.state === 'waiting_approval' || task?.approval?.state === 'pending') {
+    status = 'pending';
+    statusLabel = '待确认';
+    statusMessage = '方案待确认：等待一次性授权决定；尚未应用到计划图中。';
+  }
+
+  const goalsMap = new Map((Array.isArray(goals) ? goals : []).map(g => [g.id, g]));
+  const affected = [];
+  const affectedIds = new Set();
+
+  if (Array.isArray(resolvedCandidate?.changes)) {
+    for (const change of resolvedCandidate.changes) {
+      if (!change || typeof change !== 'object') continue;
+      const nodeId = change.node?.id ?? '未知计划';
+      affectedIds.add(nodeId);
+      const oldGoal = goalsMap.get(nodeId);
+      const oldRevision = Number.isSafeInteger(change.node?.revision)
+        ? change.node.revision
+        : (oldGoal ? oldGoal.revision : null);
+      const newRevision = oldRevision !== null ? oldRevision + 1 : null;
+      const oldSummary = typeof change.oldSummary === 'string'
+        ? change.oldSummary
+        : (oldGoal?.summary ?? null);
+      const newSummary = typeof change.summary === 'string' ? change.summary : null;
+      const reason = typeof change.reason === 'string' && change.reason.trim()
+        ? change.reason.trim()
+        : null;
+
+      const oldDeps = oldGoal?.dependencies ?? change.oldDependencies ?? null;
+      const newDeps = Array.isArray(change.dependencies) ? change.dependencies : null;
+
+      let dependenciesText;
+      if (oldDeps !== null && newDeps !== null) {
+        const oldStr = formatDependencies(oldDeps);
+        const newStr = formatDependencies(newDeps);
+        if (oldStr === newStr) {
+          dependenciesText = `依赖无变化：${newStr}`;
+        } else {
+          dependenciesText = `依赖变化：${oldStr} → ${newStr}`;
+        }
+      } else if (newDeps !== null) {
+        dependenciesText = `新依赖：${formatDependencies(newDeps)}（原依赖未记录）`;
+      } else {
+        dependenciesText = '未指定新依赖';
+      }
+
+      affected.push({
+        id: nodeId,
+        oldRevision,
+        newRevision,
+        oldSummary,
+        newSummary,
+        reason,
+        oldDependencies: oldDeps,
+        newDependencies: newDeps,
+        dependenciesText,
+      });
+    }
+  }
+
+  const preserved = [];
+  const candidatePreserved = Array.isArray(resolvedCandidate?.preserved)
+    ? resolvedCandidate.preserved
+    : (Array.isArray(resolvedCandidate?.preservedNodes)
+      ? resolvedCandidate.preservedNodes
+      : (Array.isArray(resolvedCandidate?.preserved_steps) ? resolvedCandidate.preserved_steps : []));
+
+  for (const item of candidatePreserved) {
+    if (!item || typeof item !== 'object' || !item.id) continue;
+    if (!affectedIds.has(item.id)) {
+      preserved.push({
+        id: item.id,
+        revision: item.revision ?? null,
+        summary: item.summary ?? '无摘要',
+        dependencies: item.dependencies ?? [],
+      });
+    }
+  }
+
+  for (const goal of (goals || [])) {
+    if (!affectedIds.has(goal.id) && !preserved.some(p => p.id === goal.id)) {
+      preserved.push({
+        id: goal.id,
+        revision: goal.revision,
+        summary: goal.summary,
+        dependencies: goal.dependencies ?? [],
+      });
+    }
+  }
+
+  const hasPreview = Boolean(resolvedCandidate || isConflict || isInsufficient || affected.length > 0);
+
+  return {
+    hasPreview,
+    status,
+    statusLabel,
+    statusMessage,
+    expectedGraphRevision,
+    currentGraphRevision,
+    affected,
+    preserved,
+  };
+}
+
+export function renderRepairPreview(container, data) {
+  if (!container) return;
+  container.replaceChildren();
+  if (!data || !data.hasPreview) {
+    container.hidden = true;
+    return;
+  }
+  container.hidden = false;
+
+  const title = element('h3', '计划修复预览');
+  container.append(title);
+
+  const banner = element('div');
+  banner.className = `repair-status-banner repair-status-${data.status}`;
+  const badge = element('span', data.statusLabel);
+  badge.className = `repair-status-badge badge-${data.status}`;
+  badge.setAttribute('data-status-badge', data.status);
+  const msg = element('span', data.statusMessage);
+  msg.className = 'repair-status-text';
+  banner.append(badge, msg);
+  container.append(banner);
+
+  if (data.expectedGraphRevision !== null || data.currentGraphRevision !== null) {
+    const meta = element('div');
+    meta.className = 'repair-meta-row';
+    const expText = data.expectedGraphRevision !== null ? `预期图版本 ${data.expectedGraphRevision}` : '预期图版本未指定';
+    const curText = data.currentGraphRevision !== null ? `当前图版本 ${data.currentGraphRevision}` : '当前图版本未知';
+    meta.textContent = `${expText} · ${curText}`;
+    container.append(meta);
+  }
+
+  const affectedSection = element('div');
+  affectedSection.className = 'repair-section repair-affected-section';
+  affectedSection.setAttribute('aria-label', '受影响的计划');
+  const affectedTitle = element('h4', `受影响的计划（${data.affected.length}）`);
+  affectedSection.append(affectedTitle);
+
+  if (data.affected.length === 0) {
+    const emptyNotice = element('p', data.status === 'insufficient'
+      ? '信息不足：未包含任何有效计划变更。'
+      : '无受影响的计划。');
+    emptyNotice.className = 'repair-empty-notice';
+    affectedSection.append(emptyNotice);
+  } else {
+    for (const item of data.affected) {
+      const card = element('div');
+      card.className = 'repair-item-card repair-affected-card';
+      card.setAttribute('data-affected-node', item.id);
+
+      const header = element('div');
+      header.className = 'repair-card-header';
+      const nodeTitle = element('strong', item.id);
+      const revText = item.oldRevision !== null
+        ? `版本 ${item.oldRevision} → ${item.newRevision ?? (item.oldRevision + 1)}`
+        : '原版本未记录';
+      const revTag = element('span', revText);
+      revTag.className = 'repair-tag';
+      header.append(nodeTitle, revTag);
+
+      const diff = element('div');
+      diff.className = 'repair-summary-diff';
+
+      const oldSummaryP = element('p');
+      oldSummaryP.append(element('span', '原摘要：'),
+        element('span', item.oldSummary ?? '原摘要未记录'));
+      if (!item.oldSummary) oldSummaryP.className = 'text-muted';
+
+      const newSummaryP = element('p');
+      newSummaryP.append(element('span', '新摘要：'),
+        element('strong', item.newSummary ?? '未提供新摘要'));
+
+      diff.append(oldSummaryP, newSummaryP);
+
+      const reasonP = element('p');
+      reasonP.className = 'repair-reason-row';
+      reasonP.append(element('span', '修复原因：'),
+        element('span', item.reason ?? '未提供修复原因'));
+      if (!item.reason) reasonP.className = 'repair-reason-row text-muted';
+
+      const depsP = element('p');
+      depsP.className = 'repair-deps-row';
+      depsP.textContent = item.dependenciesText;
+
+      card.append(header, diff, reasonP, depsP);
+      affectedSection.append(card);
+    }
+  }
+  container.append(affectedSection);
+
+  const preservedSection = element('div');
+  preservedSection.className = 'repair-section repair-preserved-section';
+  preservedSection.setAttribute('aria-label', '保持不变的计划');
+  const preservedTitle = element('h4', `保持不变的计划（${data.preserved.length}）`);
+  preservedSection.append(preservedTitle);
+
+  if (data.preserved.length === 0) {
+    const emptyNotice = element('p', '暂无保持不变的计划。');
+    emptyNotice.className = 'repair-empty-notice';
+    preservedSection.append(emptyNotice);
+  } else {
+    for (const item of data.preserved) {
+      const card = element('div');
+      card.className = 'repair-item-card repair-preserved-card';
+      card.setAttribute('data-preserved-node', item.id);
+
+      const header = element('div');
+      header.className = 'repair-card-header';
+      header.append(element('strong', item.id));
+      const revText = Number.isSafeInteger(item.revision) ? `版本 ${item.revision}` : '版本未知';
+      header.append(element('span', revText));
+      const tag = element('span', '保持不变');
+      tag.className = 'repair-tag tag-preserved';
+      header.append(tag);
+
+      const summaryP = element('p', item.summary ?? '无摘要');
+      summaryP.className = 'repair-preserved-summary';
+
+      const depsP = element('p', `依赖：${formatDependencies(item.dependencies)}`);
+      depsP.className = 'repair-deps-row text-muted';
+
+      card.append(header, summaryP, depsP);
+      preservedSection.append(card);
+    }
+  }
+  container.append(preservedSection);
+}
+
