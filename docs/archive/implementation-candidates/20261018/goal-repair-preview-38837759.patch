@@ -459,0 +467,241 @@ test('Goal expiry callbacks cannot replace newer draft feedback or another appro
+
+function fakeDoc(t) {
+  if (!documents.has(t)) {
+    const original = globalThis.document;
+    documents.set(t, original);
+    t.after(() => { globalThis.document = original; });
+  }
+  globalThis.document = {querySelector: () => null, createElement: tag => new FakeElement(tag), head: new FakeElement('head')};
+}
+const textOf = node => walk(node).map(n => n.textContent).join(' ');
+
+test('repair preview clearly separates affected plans from preserved plans with exact node identities', t => {
+  fakeDoc(t);
+  const currentGoals = [
+    {id: 'attend', revision: 1, summary: 'Attend meeting at 15:00', dependencies: [{id: 'meeting', revision: 1}]},
+    {id: 'prepare', revision: 1, summary: 'Prepare at 14:00', dependencies: [{id: 'attend', revision: 1}]},
+    {id: 'unrelated', revision: 1, summary: 'Unrelated goal remains active', dependencies: []},
+  ];
+  const candidate = {
+    expectedGraphRevision: 5,
+    changes: [
+      {
+        node: {id: 'attend', revision: 1},
+        summary: 'Attend meeting at 17:00',
+        reason: 'Meeting was rescheduled to 17:00 by host',
+        dependencies: [{id: 'meeting', revision: 2}],
+      },
+      {
+        node: {id: 'prepare', revision: 1},
+        summary: 'Prepare at 16:00',
+        reason: 'Preparation shifts one hour prior to 17:00',
+        dependencies: [{id: 'attend', revision: 2}],
+      },
+    ],
+  };
+  const task = {
+    taskId: 'repair-task-1',
+    state: 'waiting_approval',
+    approval: {state: 'pending', approvalId: 'app-1', revision: 1},
+    candidate,
+  };
+  const preview = projectRepairPreview({task, candidate, goals: currentGoals, graphRevision: 5});
+  assert.equal(preview.status, 'pending');
+  assert.equal(preview.statusLabel, '待确认');
+  assert.equal(preview.affected.length, 2);
+  assert.deepEqual(preview.affected.map(a => a.id), ['attend', 'prepare']);
+  assert.equal(preview.preserved.length, 1);
+  assert.equal(preview.preserved[0].id, 'unrelated');
+  assert.equal(preview.preserved[0].summary, 'Unrelated goal remains active');
+
+  const container = new FakeElement('section');
+  renderRepairPreview(container, preview);
+  assert.equal(container.hidden, false);
+  const allNodes = walk(container);
+  const affectedSection = allNodes.find(n => n.attrs['aria-label'] === '受影响的计划');
+  const preservedSection = allNodes.find(n => n.attrs['aria-label'] === '保持不变的计划');
+  assert.ok(affectedSection);
+  assert.ok(preservedSection);
+  assert.match(textOf(affectedSection), /受影响的计划（2）/);
+  assert.match(textOf(affectedSection), /attend/);
+  assert.match(textOf(affectedSection), /prepare/);
+  assert.match(textOf(preservedSection), /保持不变的计划（1）/);
+  assert.match(textOf(preservedSection), /unrelated/);
+  assert.match(textOf(preservedSection), /保持不变/);
