    "./bridge": {"types": "./dist/bridge.d.ts", "import": "./dist/bridge.js"},
    "./tool": {"types": "./dist/tool.d.ts", "import": "./dist/tool.js"},
    "./testing": {"types": "./dist/testing.d.ts", "import": "./dist/testing.js"},
    "./write": {"types": "./dist/write.d.ts", "import": "./dist/write.js"},
    "./wiki": {"types": "./dist/wiki.d.ts", "import": "./dist/wiki.js"},
    "./document-import": {"types": "./dist/document-import/index.d.ts", "import": "./dist/document-import/index.js"},
